[TEMPLATE]
# Frontend environment example for Tatvika
# Copy this file to frontend/.env and replace the sample values.

# Backend API base URL (used by all portal pages and the admin panel)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Admin API token for secure content management
VITE_ADMIN_API_TOKEN=dev-admin-token
